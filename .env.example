APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


# --- Multi-connection settings (fill in per environment; no secrets in this file) ---
# Driver per connection, e.g. sqlsrv or mysql
DB_DRIVER_BUDGETING=
DB_DRIVER_SALESDATA=

# sqlsrv encrypt / trust-server-certificate flags (per connection)
DB_ENCRYPT=
DB_ENCRYPT_BUDGETING=
DB_ENCRYPT_SALESDATA=
DB_ENCRYPT_OMSL=
DB_ENCRYPT_PRD=
DB_ENCRYPT_PRD109=
DB_TRUST_SERVER_CERTIFICATE=
DB_TRUST_SERVER_CERTIFICATE_BUDGETING=
DB_TRUST_SERVER_CERTIFICATE_SALESDATA=
DB_TRUST_SERVER_CERTIFICATE_OMSL=
DB_TRUST_SERVER_CERTIFICATE_PRD=
DB_TRUST_SERVER_CERTIFICATE_PRD109=

# OMSL
DB_HOST_OMSL=
DB_PORT_OMSL=
DB_DATABASE_OMSL=
DB_USERNAME_OMSL=
DB_PASSWORD_OMSL=
# PRD
DB_HOST_PRD=
DB_PORT_PRD=
DB_DATABASE_PRD=
DB_USERNAME_PRD=
DB_PASSWORD_PRD=
# PRD109
DB_HOST_PRD109=
DB_PORT_PRD109=
DB_DATABASE_PRD109=
DB_USERNAME_PRD109=
DB_PASSWORD_PRD109=
# PRD199
DB_HOST_PRD199=
DB_PORT_PRD199=
DB_DATABASE_PRD199=
DB_USERNAME_PRD199=
DB_PASSWORD_PRD199=
